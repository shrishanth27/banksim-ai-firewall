# Server Configuration
PORT=3000
NODE_ENV=development

# Optional AI Firewall API Keys (leave blank to run in deterministic Rule-Based Only Mode)
# Option 1: Google Gemini API (Recommended for fast structured JSON)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI API (or any OpenAI-compatible provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Security Policy Flags
FIREWALL_STRICT_MODE=true
REQUIRE_CONFIRMATION_STEP=true
